{
  "name": "agroheal-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "yarn@1.22.19",
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=1.22.19 <2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "resolutions": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3"
  },
  "scripts": {
    "dev": "concurrently -n \"web,admin\" -c \"cyan,magenta\" \"yarn web:dev\" \"yarn admin:dev\"",
    "build": "yarn web:build && yarn admin:build",
    "web:dev": "yarn workspace web dev",
    "web:build": "yarn workspace web build",
    "web:typecheck": "yarn workspace web typecheck",
    "web:lint": "yarn workspace web lint",
    "admin:dev": "yarn workspace admin dev",
    "admin:build": "yarn workspace admin build",
    "admin:typecheck": "yarn workspace admin typecheck",
    "admin:lint": "yarn workspace admin lint"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
