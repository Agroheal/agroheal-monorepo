{
  "name": "agroheal-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "yarn@1.22.19",
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=1.22.19 <2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "resolutions": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3"
  },
  "scripts": {
    "dev": "concurrently -n \"web,admin\" -c \"cyan,magenta\" \"npm run web:dev\" \"npm run admin:dev\"",
    "build": "npm run web:build && npm run admin:build",
    "web:dev": "npm --workspace=web run dev",
    "web:build": "npm --workspace=web run build",
    "web:typecheck": "npm --workspace=web run typecheck",
    "web:lint": "npm --workspace=web run lint",
    "admin:dev": "npm --workspace=admin run dev",
    "admin:build": "npm --workspace=admin run build",
    "admin:typecheck": "npm --workspace=admin run typecheck",
    "admin:lint": "npm --workspace=admin run lint"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
